{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/internal/publish.js": {
      "maxDuration": 60
    },
    "api/newsletter.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/newsletter/:path*",
      "destination": "/api/newsletter"
    }
  ]
}
